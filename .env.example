# rice-ai 配置模板：复制成 .env 后填写密钥
#   cp .env.example .env
# .env 已被 .gitignore 忽略；真实环境变量优先级高于本文件。

# 必填：DeepSeek API key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# 可选：模型与网关（任何 OpenAI 兼容接口都可以）
RICE_AI_MODEL=deepseek-chat
RICE_AI_BASE_URL=https://api.deepseek.com

# 可选：数据源与存储
RICE_AI_SUBREDDIT=unixporn
RICE_AI_DB=data/rice.db
RICE_AI_CACHE=.cache

# 可选：访问 reddit.com 的最小间隔（秒），限流严重时可调大
RICE_AI_MIN_INTERVAL=6

# 可选：日志级别 WARNING / INFO / DEBUG
RICE_AI_LOG=WARNING

# 可选：提高 GitHub API 配额（不填则走 raw.githubusercontent.com）
GITHUB_TOKEN=
